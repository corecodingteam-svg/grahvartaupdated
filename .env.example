# ── Copy this to .env and fill in real values before deploying ──────────────
# Used by docker-compose.yml

# Domain
DOMAIN=grahvarta.com
API_DOMAIN=api.grahvarta.com
VITE_API_URL=https://api.grahvarta.com

# Database (must match backend/.env)
DB_NAME=grahvarta_db
DB_USER=grahvarta_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Firebase Analytics for the web apps (public values, baked in at build time).
# Register one Web app per site in Firebase project grahvarta-astrology; the
# browser API key is shared. Leave blank to build a site without analytics.
FIREBASE_WEB_API_KEY=
WEB_FIREBASE_APP_ID=
WEB_FIREBASE_MEASUREMENT_ID=
ASTRO_PORTAL_FIREBASE_APP_ID=
ASTRO_PORTAL_FIREBASE_MEASUREMENT_ID=
ADMIN_FIREBASE_APP_ID=
ADMIN_FIREBASE_MEASUREMENT_ID=
