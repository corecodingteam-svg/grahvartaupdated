GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
SERVER_PORT=8787

# Real astro-talk-backend (same backend the Flutter app uses) — leave blank
# to develop against nothing (auth/astrologer calls will just network-error,
# which every call site handles gracefully). VITE_-prefixed vars are exposed
# to the browser bundle, which is fine here: these are base URLs, not secrets.
VITE_API_URL=
VITE_SOCKET_URL=
