# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── PostgreSQL ────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=astro_talk
DB_USER=astro_user
DB_PASSWORD=your_db_password

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRES_IN=30d

# ── URLs ──────────────────────────────────────────────────
APP_URL=https://api.grahvarta.com
FRONTEND_URL=https://grahvarta.com
CORS_ORIGIN=https://grahvarta.com,https://www.grahvarta.com

# ── Razorpay ──────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_ACCOUNT_NUMBER=

# ── Agora (voice/video) ───────────────────────────────────
AGORA_APP_ID=cfc5ddec9cdd48f09a301aba96991a25
AGORA_APP_CERTIFICATE=your_agora_certificate

# ── Firebase Admin (FCM push notifications) ──────────────
# Paste the entire service account JSON as a single line
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ── Upload storage ────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# SMTP (Hostinger) — used for agent email OTP + astrologer welcome emails
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@grahvarta.com
SMTP_PASS=

# Testing: one-time wallet credit for new users (set 0 to disable)
TEST_WALLET_CREDIT=1000

# Razorpay webhook secret (Dashboard → Webhooks; events payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# Agora Real-Time STT for call transcripts (Agora console → RESTful API)
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AGORA_STT_LANGUAGES=en-IN,hi-IN
